# ============================================================
# 无人机多模态智能目标跟踪与制导 —— git 忽略清单
# 原则：凡「能自动重新生成」的产物都不入库
# ============================================================

# ---- catkin 生成物（catkin_make 生成，勿提交）----
catkin_ws/build/
catkin_ws/devel/
catkin_ws/install/
catkin_ws/.catkin_workspace
# catkin_make 首次运行时自动创建的软链（指向 ROS toplevel.cmake）
catkin_ws/src/CMakeLists.txt

# ---- Python / Jupyter 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.jupyter/

# ---- 测试产物 ----
.pytest_cache/
test/**/logs/

# ---- 其它运行时产物 ----
nohup.out
*.bag

# ---- 本地 MCP / 工具配置（不入库）----
.mcp.json
mcp_filters/
mcp使用注意事项/
